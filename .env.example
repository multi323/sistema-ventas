# TILIO - Variables de Entorno

# SERVIDOR
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=tilio-secret-key-2026

# TWILIO (opcional - para WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
